    <DataTemplate x:Key="TopPanelFilterPresetsSelectionTemplate">
        <TextBlock Text="&#xeec0;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelGroupSettingsTemplate">
        <TextBlock Text="&#xee03;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSortSettingsTemplate">
        <TextBlock Text="&#xefee;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchDetailsViewTemplate">
        <TextBlock Text="&#xE145;" FontFamily="Segoe UI Symbol" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchGridViewTemplate">
        <TextBlock Text="&#xE138;" FontFamily="Segoe UI Symbol" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSwitchListViewTemplate">
        <TextBlock Text="&#xE14C;" FontFamily="Segoe UI Symbol" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelUpdateButtonTemplate">
        <TextBlock Text="&#xef08;" FontFamily="{DynamicResource FontIcoFont}" FontSize="22" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelExplorerSwitchTemplate">
        <TextBlock Text="&#xeeed;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xef03;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelViewSelectRandomGameButtonTemplate">
        <TextBlock Text="&#xefcf;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <DataTemplate x:Key="TopPanelSearchButtonTemplate">
        <TextBlock Text="&#xed12;" FontFamily="{DynamicResource FontIcoFont}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </DataTemplate>
    <Style x:Key="TopPanelMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource PopupBorderThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border x:Name="MenuSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource VesperCardCornerRadius}"
                            Padding="6"
                            Grid.IsSharedSizeScope="True"
                            Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform Y="-6" />
                        </Border.RenderTransform>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                            <BeginStoryboard x:Name="MenuOpenStoryboard" HandoffBehavior="SnapshotAndReplace">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(ContextMenu.PlacementTarget).(FrameworkElement.Parent).(FrameworkElement.Tag)">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource True}" />
                                    </ObjectAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetName="MenuSurface"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="MenuSurface"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                     To="0"
                                                     Duration="0:0:0.22">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="MenuOpenStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TopPanelFilterToggle" TargetType="CheckBox">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{DynamicResource VesperSurfaceSoftBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource VesperGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <StackPanel Orientation="Horizontal" Margin="9,0">
                            <TextBlock Text="&#xef29;"
                                       FontFamily="{DynamicResource FontIcoFont}"
                                       FontSize="19"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="TextFilter"
                                       Text="{DynamicResource LOCFilterActiveLabel}"
                                       Style="{DynamicResource BaseTextBlockStyle}"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter TargetName="TextFilter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VesperSelectionBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource VesperAccentBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="{StaticResource False}">
                            <Setter TargetName="TextFilter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VesperSurfaceHoverBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource VesperAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource VesperAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TopPanelNotificationsToggle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface"
                            Background="{DynamicResource VesperSurfaceSoftBrush}"
                            BorderBrush="{DynamicResource VesperGlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                            <TextBlock Text="&#xeea3;"
                                       FontFamily="{DynamicResource FontIcoFont}"
                                       FontSize="21"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Border Width="16"
                                    Height="16"
                                    Margin="22,0,-4,-4"
                                    Background="{DynamicResource VesperAccentBrush}"
                                    CornerRadius="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                                <TextBlock Text="{Api Notifications.Count}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextBrushDark}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VesperSurfaceHoverBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource VesperAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource VesperAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type TopPanel}">
        <Setter Property="Height" Value="56" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanel}">
                    <Grid Height="56"
                          ClipToBounds="False"
                          Background="{x:Null}"
                          IsHitTestVisible="True"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          d:DesignWidth="1280"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Border Height="2"
                                Margin="20,0,130,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource VesperAccentBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.7" />
                        <Border x:Name="StateLatch"
                                Width="0"
                                Height="0"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="EdgeTrigger"
                                Height="4"
                                Margin="0,0,122,0"
                                VerticalAlignment="Top"
                                Background="#01000000"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border x:Name="SafeZone"
                                Height="56"
                                Margin="0,0,122,0"
                                VerticalAlignment="Top"
                                Background="#01000000"
                                IsHitTestVisible="False"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border x:Name="PanelSurface"
                                    Height="56"
                                    Margin="12,0,0,0"
                                    Padding="7"
                                    VerticalAlignment="Top"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Style="{DynamicResource VesperGlassPanelStyle}"
                                    CornerRadius="0,0,16,16"
                                    Opacity="0.18">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="-46" />
                                </Border.RenderTransform>
                                <DockPanel>
                                <Border x:Name="PART_ElemMainMenu"
                                        Width="40"
                                        Margin="0,0,7,0"
                                        DockPanel.Dock="Left"
                                        Background="{DynamicResource VesperSelectionBrush}"
                                        BorderBrush="{DynamicResource VesperAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Cursor="Hand"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Image Source="{DynamicResource PlayniteLogo}"
                                           Width="30"
                                           Height="30"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant" />
                                </Border>
                                <SearchBox x:Name="PART_TextMainSearch"
                                           Width="340"
                                           Margin="0,0,7,0"
                                           DockPanel.Dock="Left"
                                           WindowChrome.IsHitTestVisibleInChrome="True" />
                                <StackPanel x:Name="PART_PanelMainItems"
                                             Orientation="Horizontal"
                                             VerticalAlignment="Stretch"
                                             Tag="{StaticResource False}" />
                                <CheckBox x:Name="PART_ToggleFilter"
                                          DockPanel.Dock="Left"
                                          ToolTip="{DynamicResource LOCFilters}"
                                          Style="{DynamicResource TopPanelFilterToggle}" />
                                <CheckBox x:Name="PART_ToggleNotifications"
                                          DockPanel.Dock="Left"
                                          Style="{DynamicResource TopPanelNotificationsToggle}" />
                                <StackPanel x:Name="PART_PanelMainPluginItems"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Stretch"
                                            Margin="7,0"
                                            DockPanel.Dock="{Settings PluginTopPanelAlignment}" />
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Grid MaxWidth="420" MinWidth="220">
                                        <ProgressBar Name="PART_ProgressGlobal" />
                                        <TextBlock Name="PART_TextProgressText"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Style="{DynamicResource BaseTextBlockStyle}"
                                                   Margin="5,0" />
                                    </Grid>
                                    <Button Name="PART_ButtonProgressCancel"
                                            Content="{DynamicResource LOCCancelLabel}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Margin="6,0,0,0" />
                                </StackPanel>
                                </DockPanel>
                            </Border>
                        </Border>
                    </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger SourceName="EdgeTrigger" RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StateLatch"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger SourceName="SafeZone" RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StateLatch"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0"
                                                         Duration="0:0:0.42">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger SourceName="SafeZone" RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         BeginTime="0:0:0.50"
                                                         To="0.18"
                                                         Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         BeginTime="0:0:0.50"
                                                         To="-46"
                                                         Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="StateLatch"
                                                         Storyboard.TargetProperty="Opacity"
                                                         BeginTime="0:0:0.70"
                                                         To="0"
                                                         Duration="0" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger SourceName="StateLatch" Property="Opacity" Value="1">
                                <Setter TargetName="SafeZone" Property="IsHitTestVisible" Value="True" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=SafeZone}" Value="False" />
                                    <Condition Binding="{Binding Tag, ElementName=PART_PanelMainItems}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="Compose">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             BeginTime="0:0:0.50"
                                                             To="0.18"
                                                             Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             BeginTime="0:0:0.50"
                                                             To="-46"
                                                             Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                    <BeginStoryboard HandoffBehavior="Compose">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLatch"
                                                             Storyboard.TargetProperty="Opacity"
                                                             BeginTime="0:0:0.70"
                                                             To="0"
                                                             Duration="0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Tag, ElementName=PART_PanelMainItems}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="StateLatch"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="PanelSurface"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0"
                                                             Duration="0:0:0.42">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgourndBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid d:DesignWidth="1500"
                          d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <FadeImage x:Name="PART_ImageBackground"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Stretch="UniformToFill"
                                   Opacity="0.82"
                                   IsHitTestVisible="False" />
                        <Border Background="{DynamicResource WindowBackgourndBrush}"
                                Opacity="0.46"
                                IsHitTestVisible="False" />
                        <Border Background="{DynamicResource VesperAccentBrush}"
                                Opacity="0.34"
                                IsHitTestVisible="False">
                            <Border.OpacityMask>
                                <RadialGradientBrush Center="0.72,0.12"
                                                     GradientOrigin="0.72,0.12"
                                                     RadiusX="0.82"
                                                     RadiusY="0.72">
                                    <GradientStop Color="#B3000000" Offset="0" />
                                    <GradientStop Color="#38000000" Offset="0.38" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <DockPanel WindowChrome.IsHitTestVisibleInChrome="True">
                            <ExplorerPanel DockPanel.Dock="{Settings ExplorerPanelPosition}"
                                           Width="{Settings ExplorerPanelWitdh}"
                                           Visibility="{Settings ExplorerPanelVisible}" />
                            <FilterPanel x:Name="PART_FilterPanel"
                                         Width="320"
                                         DockPanel.Dock="Right"
                                         Visibility="{Settings FilterPanelVisible}"
                                         WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Grid DockPanel.Dock="Left">
                                <LibraryDetailsView x:Name="PART_ViewDetails" />
                                <LibraryGridView x:Name="PART_ViewGrid" />
                                <LibraryListView x:Name="PART_ViewList" />
                            </Grid>
                        </DockPanel>
                        <TopPanel Panel.ZIndex="1000" VerticalAlignment="Top" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

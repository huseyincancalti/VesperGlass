<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">
    <Style TargetType="{x:Type SearchWindowGameItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchWindowGameItem}">
                    <DockPanel Margin="8,6">
                        <Border Width="38"
                                Height="38"
                                Margin="0,0,11,0"
                                Padding="3"
                                DockPanel.Dock="Left"
                                Style="{DynamicResource VesperCardStyle}">
                            <Image x:Name="PART_ImageGameIcon" RenderOptions.BitmapScalingMode="Fant">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GameView.IsInstalled}" Value="False">
                                                <Setter Property="Opacity" Value="0.48" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PART_TextName"
                                           Margin="0,0,6,0"
                                           FontSize="{DynamicResource FontSizeLarge}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <Image x:Name="PART_ImageLibraryIcon"
                                       Width="18"
                                       Height="18"
                                       Margin="4,0"
                                       RenderOptions.BitmapScalingMode="Fant" />
                                <TextBlock x:Name="PART_ElemHiddenStatus"
                                           Text="&#xef22;"
                                           FontFamily="{DynamicResource FontIcoFont}"
                                           Foreground="{DynamicResource VesperAccentBrush}" />
                            </StackPanel>
                            <ItemsControl x:Name="PART_ItemsAdditionalInfo" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextBrushDarker}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="SearchWindowGameItemTemplate">
        <SearchWindowGameItem />
    </DataTemplate>
    <Style TargetType="{x:Type SearchWindowSearchItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchWindowSearchItem}">
                    <DockPanel Margin="8,6">
                        <Border Width="38"
                                Height="38"
                                Margin="0,0,11,0"
                                Padding="6"
                                DockPanel.Dock="Left"
                                Style="{DynamicResource VesperCardStyle}">
                            <Viewbox>
                                <ContentControl x:Name="PART_ContentIcon" Focusable="False" />
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PART_TextName"
                                       FontSize="{DynamicResource FontSizeLarge}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="PART_TextDescription"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextBrushDarker}" />
                        </StackPanel>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="SearchWindowSearchItemTemplate">
        <SearchWindowSearchItem />
    </DataTemplate>
    <Style x:Key="SearchWindowSearchLabelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding}" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="&#xeee4;" Margin="5,0,0,0" FontFamily="{DynamicResource FontIcoFont}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SearchWindowActionButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="5,0" />
    </Style>
    <Style x:Key="SearchWindowInfoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Content" Value="&#xef50;" />
        <Setter Property="FontFamily" Value="{DynamicResource FontIcoFont}" />
    </Style>
    <Style x:Key="SearchWindowSettignsButton" TargetType="Button" BasedOn="{StaticResource SearchWindowInfoButton}">
        <Setter Property="Content" Value="&#xefb0;" />
    </Style>
    <Style x:Key="SearchWindowStyle" TargetType="WindowBase" BasedOn="{StaticResource StandardWindowStyle}">
        <Setter Property="Background" Value="{DynamicResource VesperOverlayBrush}" />
        <Setter Property="Width" Value="820" />
        <Setter Property="SizeToContent" Value="Height" />
    </Style>
    <ControlTemplate x:Key="SearchWindowFilterNotification" TargetType="ContentControl">
        <Border Padding="10,7"
                Background="{DynamicResource VesperSelectionBrush}"
                BorderBrush="{DynamicResource VesperAccentBrush}"
                BorderThickness="1,0,0,0">
            <TextBlock Text="{TemplateBinding Content}"
                       FontSize="{DynamicResource FontSizeLarge}"
                       Foreground="{DynamicResource TextBrush}" />
        </Border>
    </ControlTemplate>
    <Style x:Key="SearchWindowSearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarger}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="SearchWindowSearchDescription" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
    </Style>
    <Style x:Key="SearchWindowSearchHint" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="Margin" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
    </Style>
    <Style x:Key="SearchWindowList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="MaxHeight" Value="620" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
</ResourceDictionary>

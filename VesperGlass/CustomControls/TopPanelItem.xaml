<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type TopPanelItem}">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource VesperSurfaceSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VesperGlassBorderBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TopPanelItem}">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VesperSurfaceHoverBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource VesperAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource VesperAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsToggled" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource VesperSelectionBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource VesperAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource VesperAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
